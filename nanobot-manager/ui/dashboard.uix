<window title="nanobot manager" width="430" height="500" centered="true" frameless="true" resizable="false"/>

<script>
export default {
  data() {
    return {
      page: "dashboard",
      status: "stopped",
      statusText: "Stopped",
      statusSub: "nanobot is not running",
      canStart: true,
      canStop: false,
      port: "18790",
      pid: "-",
      uptime: "00:00",
      autostart: false,
      stayInTray: false,
      nanobotPath: "",
      theme: "system",
      installed: true,
      lang: "zh"
    };
  },
  computed: {
    statusClass() {
      if (this.status === "running") return "hero-status running";
      if (this.status === "starting") return "hero-status starting";
      return "hero-status stopped";
    }
  },
  methods: {
    nav(p) { this.page = p; },
    setLang(loc) { this.lang = loc; }
  }
}
</script>

