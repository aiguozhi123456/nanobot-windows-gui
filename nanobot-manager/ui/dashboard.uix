<window title="nanobot manager" width="430" height="500" centered="true" frameless="true" resizable="false" translucent="true" tabNavigation="true"/>

<script>
export default {
  data() {
    return {
      page: "dashboard",
      status: "stopped",
      statusText: "Stopped",
      statusSub: "nanobot is not running",
      canStart: true,
      canStop: false,
      canRefresh: true,
      port: "18790",
      pid: "-",
      uptime: "00:00",
      autostart: false,
      stayInTray: false,
      hotkeyEnabled: true,
      nanobotPath: "",
      webuiPort: "",
      webuiPortSub: "",
      gatewayPortSub: "",
      healthPort: "",
      credentialStatus: "",
      hasCredential: false,
      theme: "system",
      isDark: true,
      installed: true,
      installing: false,
      lang: "zh",
      logLevel: "info",
      messages: [],
      draft: "",
      canSend: true,
      turnWaiting: false,
      chatStatusKey: "chat_status_start_nanobot",
      chatStatusDetail: "",
      hover: "",
      ambientGlow: 1,
      ringSize: 16,
      /* Backdrop field drift positions (DIP). main.cpp's TIMER_FIELD_DRIFT
         pushes Lissajous samples into these; :left/:top move the blobs. */
      fieldAx: -20,
      fieldAy: 26,
      fieldBx: 152,
      fieldBy: 200,
      fieldCx: 168,
      fieldCy: 310
    };
  },
  computed: {
    statusDotClass() {
      if (this.status === "running") return "status-dot running";
      if (this.status === "starting") return "status-dot starting";
      return "status-dot";
    },
    statusRingClass() {
      if (this.status === "running") return "pulse-ring running";
      if (this.status === "starting") return "pulse-ring starting";
      return "pulse-ring";
    }
  },
  methods: {
    nav(p) { this.page = p; },
    setLang(loc) { this.lang = loc; },
    /* Hover fades: core-ui transitions only animate binding-driven changes,
       so hover state lives here and feeds the :opacity bindings. */
    hin(id) { this.hover = id; },
    hout(id) { if (this.hover == id) this.hover = ""; }
  }
}
</script>

<style>
  .root {
    padding: 0;
    gap: 0;
  }

  /* Light theme: the Win11 light-acrylic fog itself reads grey (darker than the
     translucent-white titlebar / inputs drawn over it), so the whole glass looks
     dim — no DWM flag fixes that (they were verified correct). Lift the base
     toward the theme surface with an achromatic white veil; hue fields below
     keep their tint on top. Calibration history: 0.8 lifted the base fully but
     read as milky ("太白、失透"), 0.6 was the 2026-10-25 user-tuned final; later
     that day the DWM fog stopped sampling the backdrop env-wide, making the
     glass read opaque white over light backdrops, so the veil was re-lowered to
     0.45 to hunt transparency (pending user calibration). An achromatic veil may
     exceed the ≤0.32 hue-field cap — that cap keeps COLORS from turning the
     glass opaque pastel, white haze doesn't fight the backdrop hue. */
  .theme-light {
    background: rgba(255, 255, 255, 0.45);
  }

  /* Hue-accent fields OVER the acrylic backdrop (kept faint: on a translucent
     window the blurred desktop is the real backdrop, and dense fields read as
     an opaque pastel wash — the "not transparent at all" effect). Two core-ui
     constraints shape the markup: radial-gradient silently IGNORES an `at`
     position prefix (center stays at default), and multi-layer comma
     backgrounds are unsupported (the value tokenizer splits function-arg
     commas). So each field is one single-layer gradient. They drift on
     Lissajous paths: absolutely positioned (no flow arithmetic — the old
     net-zero margins were one bug away from a phantom band), left/top bound
     to reactive fields that a main.cpp timer nudges. hitTransparent is
     MANDATORY here: HitTest probes absolute children first (overlay layer),
     so without it the field rects swallow every click/wheel aimed at the
     content underneath. */
  .backdrop-a {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(rgba(58, 128, 152, 0.32), rgba(58, 128, 152, 0) 70%);
  }

  .backdrop-b {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(rgba(106, 94, 188, 0.28), rgba(106, 94, 188, 0) 70%);
  }

  .backdrop-c {
    position: absolute;
    width: 260px;
    height: 240px;
    background: radial-gradient(rgba(96, 148, 90, 0.25), rgba(96, 148, 90, 0) 70%);
  }

  /* Light theme: over the bright acrylic the mid-tone hues above read as grey
     smudges instead of accents, so the glass looks dim. Same hues, lifted
     toward white and at lower alpha. Single-layer gradients, no `at` prefix —
     see the core-ui constraints note above. */
  .theme-light .backdrop-a {
    background: radial-gradient(rgba(120, 178, 196, 0.18), rgba(120, 178, 196, 0) 70%);
  }
  .theme-light .backdrop-b {
    background: radial-gradient(rgba(152, 142, 212, 0.16), rgba(152, 142, 212, 0) 70%);
  }
  .theme-light .backdrop-c {
    background: radial-gradient(rgba(148, 188, 142, 0.15), rgba(148, 188, 142, 0) 70%);
  }

  .titlebar-left {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .titlebar-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-2);
  }

  .body {
    flex-direction: row;
    gap: 0;
    flex: 1;
  }

  .sidebar {
    width: 48px;
    padding: 8px 4px;
    gap: 2px;
    align-items: center;
    /* Glass strip: white-tint frost over the backdrop color fields. Tint and
       edge highlight sit above the perception floor — a 0.06 tint over a
       smooth field reads as a plain solid strip (nothing to frost). */
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(20px);
    border-right: 1px solid rgba(255, 255, 255, 0.20);
  }

  .nav {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    cursor: pointer;
    justify-content: center;
    align-items: center;
    gap: 2px;
    color: var(--fg-3);
    background: transparent;
  }

  .nav:hover {
    background: var(--sidebar-hover);
    color: var(--fg-2);
  }

  .nav.on {
    color: var(--accent);
  }

  .nav-tick {
    /* Active-page underline. Toggled with :visible — a :height binding of 0
       would fall into core-ui's 24px default-height fallback and render a
       tall sliver instead of disappearing. */
    width: 16px;
    height: 3px;
    border-radius: 1px;
    background: var(--accent);
    transition: height 240ms ease-out;
  }

  .nav-spacer {
    flex: 1;
  }

  .content {
    flex: 1;
    padding: 0;
    gap: 0;
    background: transparent;
  }

  .page-scroll {
    flex: 1;
    padding: 16px;
    gap: 0;
  }

  /* One frosted backplate carrying the whole settings form, so the rows sit
     on glass instead of directly on the color fields. The glass MUST live on
     this plain div wrapper: ScrollViewWidget overrides DrawTree and skips the
     base-class backdrop-blur/box-shadow pass, so backdrop-filter on the
     ScrollView itself is a silent no-op. */
  .settings-glass {
    flex: 1;
    margin: 12px;
    background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.10);
  }

  .settings-scroll {
    flex: 1;
    padding: 16px;
  }

  .install-hint {
    padding: 12px 16px;
    margin-bottom: 12px;
    /* Accent-tinted glass over the backdrop. */
    background: rgba(74, 122, 140, 0.12);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    align-items: center;
    gap: 2px;
  }

  .install-hint-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  .install-hint-text {
    /* block so the long one-liner wraps and measures multi-line (same
       measure/draw agreement rule as .msg-text); center like the title. */
    display: block;
    text-align: center;
    font-size: 12px;
    color: var(--fg-2);
  }

  .install-btn {
    margin-top: 8px;
    padding: 6px 16px;
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--fg-on-accent);
    cursor: pointer;
    /* opacity is owned by the :opacity binding (hover fade) */
    transition: opacity 120ms ease-out;
  }

  .install-btn:active {
    background: var(--accent-press);
  }

  .install-btn:disabled {
    background: var(--disabled-bg);
    color: var(--disabled-text);
    cursor: default;
  }

  .install-btn:disabled .install-btn-label {
    color: var(--disabled-text);
  }

  .install-btn-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-on-accent);
  }

  .hero-panel {
    padding: 16px;
    gap: 4px;
    /* Frosted glass card over the color-field backdrop. */
    background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.10);
  }

  .hero-status-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .led-cell {
    width: 28px;
    height: 28px;
    justify-content: center;
    align-items: center;
  }

  .pulse-ring {
    /* Radar pulse on status change: C drives ringSize 16 <-> 28 (bloom then
       retract; see TIMER_PULSE in main.cpp). Opacity stays 1 — dimming the
       ring would dim its child dot with it (subtree opacity). At rest the
       16px ring reads as a subtle halo just outside the dot. */
    border-radius: 9999px;
    border: 2px solid transparent;
    justify-content: center;
    align-items: center;
    transition: width 450ms ease-out, height 450ms ease-out;
  }

  .pulse-ring.running { border-color: #4d7a5c; }
  .pulse-ring.starting { border-color: #b8860b; }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--fg-3);
    /* Heartbeat: while running, main.cpp's drift tick sets ambientGlow to a
       2.8s sine sampled at 10Hz — discrete steps. NO transition here: a
       tween runs the animation host at ~60Hz, repainting the whole window
       for one 10px dot. */
  }

  .status-dot.running { background: #4d7a5c; }
  .status-dot.starting { background: #b8860b; }

  .hero-status {
    font-size: 26px;
    font-weight: 700;
    color: var(--fg);
  }

  .hero-sub {
    font-size: 12px;
    color: var(--fg-3);
  }

  .metrics {
    flex-direction: row;
    justify-content: flex-start;
    gap: 36px;
    padding: 12px 16px;
    margin-top: 8px;
    background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.10);
  }

  .metric {
    align-items: flex-start;
    gap: 2px;
  }

  .metric-val {
    font-size: 18px;
    font-weight: 700;
    color: var(--fg);
  }

  .metric-label {
    font-size: 11px;
    color: var(--fg-3);
  }

  .actions {
    padding: 16px 0 0;
    flex-direction: row;
    gap: 8px;
  }

  .btn {
    flex: 1;
    height: 36px;
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
  }

  .btn-start {
    background: var(--accent);
    color: var(--fg-on-accent);
  }

  .btn-start:hover {
    background: var(--accent-hover);
  }

  .btn-start:active {
    background: var(--accent-press);
  }

  .btn-start:disabled,
  .btn-start:disabled:hover {
    background: var(--disabled-bg);
    color: var(--disabled-text);
    cursor: default;
  }

  .btn-start:disabled .btn-label {
    color: var(--disabled-text);
  }

  .btn-stop {
    background: rgba(192, 80, 77, 0.12);
    color: #c0504d;
  }

  .btn-stop:active {
    background: rgba(192, 80, 77, 0.22);
  }

  .btn-stop:disabled,
  .btn-stop:disabled:hover {
    background: var(--disabled-bg);
    color: var(--disabled-text);
    cursor: default;
  }

  .btn-stop:disabled .btn-label {
    color: var(--disabled-text);
  }

  .btn-refresh {
    background: var(--btn-bg);
    color: var(--fg-2);
  }

  .btn-refresh:hover {
    background: var(--btn-hover);
  }

  .btn-refresh:active {
    background: var(--btn-press);
  }

  .btn-refresh:disabled,
  .btn-refresh:disabled:hover {
    background: var(--disabled-bg);
    color: var(--disabled-text);
    cursor: default;
  }

  .btn-label {
    font-size: 13px;
    font-weight: 600;
  }

  .chat-page {
    flex: 1;
    flex-direction: column;
    gap: 0;
    padding: 0;
  }

  .chat-status-bar {
    padding: 6px 12px;
    font-size: 11px;
    color: var(--fg-3);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    min-height: 24px;
    justify-content: center;
  }

  .chat-status-text {
    font-size: 11px;
    color: var(--fg-3);
  }

  .chat-scroll {
    flex: 1;
    padding: 10px 12px;
  }

  .chat-list {
    gap: 0;
    /* Bottom clearance so the last bubble can scroll under the floating
       glass composer instead of stopping above it. */
    padding: 0 0 64px 0;
  }

  .chat-empty {
    flex: 1;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 32px 16px;
    min-height: 160px;
  }

  .chat-empty-icon {
    color: var(--fg-3);
    opacity: 0.35;
  }

  .chat-empty-text {
    font-size: 12px;
    color: var(--fg-3);
    text-align: center;
  }

  .msg {
    max-width: 85%;
    padding: 8px 10px;
    border-radius: 6px;
    margin-bottom: 8px;
  }

  .msg.user {
    align-self: flex-end;
    background: var(--accent);
    color: var(--fg-on-accent);
    border-bottom-right-radius: 2px;
  }

  .msg.bot {
    align-self: flex-start;
    background: var(--bg-2);
    color: var(--fg);
    border-bottom-left-radius: 2px;
  }

  .msg-text {
    /* block, not the label default inline. An inline wrap label reports a
       single-line height (SizeHint -> HeightForWidth(fixedW=0) skips the
       multi-line branch) while OnDraw wraps to N lines at the bubble's
       max-width:85%, so multi-line bot replies overlap. block stretches the
       label to the bubble's resolved width, making measure and draw agree.
       Shrink-to-fit is preserved: the bubble's own width still comes from the
       label's intrinsic SizeHint width, clamped by max-width. */
    display: block;
    font-size: 13px;
    color: inherit;
  }

  .composer {
    /* Floating glass bar laid OVER the ScrollView: absolute children paint
       above flow siblings (no z-index in core-ui), which is exactly the
       layer order a frosted overlay needs. Message bubbles scroll beneath
       it and show through the blur.
       Width must be explicit: core-ui's absolute sizing takes fixedW or the
       SizeHint and NEVER stretches between left and right (posRight is only
       an anchor when posLeft is absent), so `left:0; right:0` would collapse
       to the content's natural width. Window is fixed 430x500 with a 48px
       sidebar → the chat column is always 382px wide. */
    position: absolute;
    left: 0;
    bottom: 0;
    width: 382px;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(24px);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.08);
  }

  .chat-input {
    flex: 1;
    height: 32px;
    font-size: 13px;
  }

  .btn-send {
    height: 32px;
    padding: 6px 12px;
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--fg-on-accent);
    cursor: pointer;
    /* opacity is owned by the :opacity binding (hover fade) */
    transition: opacity 120ms ease-out;
  }

  .btn-send:active {
    background: var(--accent-press);
  }

  .btn-send-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-on-accent);
  }

  .btn-send:disabled {
    background: var(--disabled-bg);
    color: var(--disabled-text);
    cursor: default;
  }

  .btn-send:disabled .btn-send-label {
    color: var(--disabled-text);
  }

  /* Secondary variant of btn-send: lower presence, only meaningful while a
     turn is in flight (:enabled="turnWaiting"). Disabled it fades to a bare
     label so it never competes with the primary send button. */
  .btn-chat-stop {
    height: 32px;
    padding: 6px 10px;
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.12);
    cursor: pointer;
    /* opacity is owned by the :opacity binding (hover fade) */
    transition: opacity 120ms ease-out;
  }

  .btn-chat-stop:active {
    background: rgba(255, 255, 255, 0.20);
  }

  .btn-chat-stop-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-2);
  }

  .btn-chat-stop:disabled {
    background: transparent;
    cursor: default;
  }

  .btn-chat-stop:disabled .btn-chat-stop-label {
    color: var(--disabled-text);
  }

  .settings-section-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-2);
    padding: 16px 0 8px;
  }

  .setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    gap: 0;
  }

  .setting-label-wrap {
    gap: 1px;
  }

  .setting-label {
    font-size: 13px;
    color: var(--fg);
  }

  .setting-sub {
    font-size: 10px;
    color: var(--fg-3);
  }

  .path-row {
    padding: 10px 0;
    gap: 4px;
  }

  .path-display {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    /* Same smoke-glass language as the composer (white-alpha reads as a soft
       field on the frosted card in both themes; solid --bg-2 read as slabs). */
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    cursor: pointer;
  }

  .path-text {
    font-size: 11px;
    color: var(--fg-2);
    flex: 1;
  }

  .path-change {
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
  }

  .setting-col {
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
  }

  .port-input {
    /* No custom background/border: TextInputWidget's default WinUI state
       machine (smoke fill + underline + focus accent) is the chat-input look
       the settings fields should match; a solid --input-bg box reads as a
       flat black/white slab on the glass card. */
    height: 32px;
    font-size: 13px;
    padding: 0 8px;
    border-radius: 4px;
  }

  .apply-row {
    flex-direction: row;
    justify-content: flex-end;
    padding: 6px 0 0;
  }

  .apply-btn {
    padding: 6px 16px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--fg-on-accent);
    cursor: pointer;
    /* opacity is owned by the :opacity binding (hover fade) */
    transition: opacity 120ms ease-out;
  }

  .apply-btn:active {
    background: var(--accent-press);
  }

  .apply-btn-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-on-accent);
  }

  .credential-row {
    flex-direction: column;
    gap: 6px;
    padding: 8px 0 4px;
  }

  .credential-status-wrap {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    /* Same smoke-glass field as .path-display (chat-input look-alike). */
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
  }

  .credential-status-label {
    font-size: 11px;
    color: var(--fg-3);
  }

  .credential-status-val {
    font-size: 12px;
    color: var(--fg);
    flex: 1;
  }

  .credential-actions {
    flex-direction: row;
    gap: 8px;
    justify-content: flex-end;
  }

  /* Neutral surface: accent is reserved for the primary actions. */
  .credential-btn {
    padding: 6px 14px;
    border-radius: 4px;
    background: var(--btn-bg);
    color: var(--fg-2);
    cursor: pointer;
    /* opacity is owned by the :opacity binding (hover fade) */
    transition: opacity 120ms ease-out;
  }

  .credential-btn:active {
    background: var(--btn-press);
  }

  .credential-btn-label {
    font-size: 12px;
    font-weight: 600;
    color: inherit;
  }

  .theme-row {
    flex-direction: row;
    gap: 4px;
    padding: 8px 0;
  }

  .theme-btn {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    cursor: pointer;
    justify-content: center;
    align-items: center;
    color: var(--fg-3);
    /* Smoke glass, not a solid slab: solid --btn-bg reads as a flat tile on
       the frosted card. Active state lifts via a denser fill + border. */
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .theme-btn-active {
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.34);
    color: var(--fg);
  }

  .lang-row {
    flex-direction: row;
    gap: 4px;
    padding: 8px 0;
  }

  .lang-btn {
    padding: 4px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    color: var(--fg-3);
    /* Same smoke glass as .theme-btn (no solid slabs on the glass card). */
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-weight: 500;
  }

  .lang-btn-active {
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.34);
    color: var(--fg);
    font-weight: 600;
  }

  .settings-footer {
    padding: 16px 0 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 0;
  }

  .footer-ver {
    font-size: 10px;
    color: var(--fg-3);
  }

  .footer-link {
    flex-direction: row;
    align-items: center;
    gap: 3px;
    cursor: pointer;
  }

  .footer-link-text {
    font-size: 11px;
    color: var(--accent);
  }
</style>

<template>
  <div class="root" :class="isDark ? 'theme-dark' : 'theme-light'">
    <div class="backdrop-a" :left="fieldAx" :top="fieldAy" hitTransparent="true"></div>
    <div class="backdrop-b" :left="fieldBx" :top="fieldBy" hitTransparent="true"></div>
    <div class="backdrop-c" :left="fieldCx" :top="fieldCy" hitTransparent="true"></div>
    <TitleBar title="">
      <div class="titlebar-left">
        <label class="titlebar-title">{{ $t('app_title') }}</label>
      </div>
    </TitleBar>

    <div class="body">
      <div class="sidebar">
        <div class="nav" :class="page=='chat' ? 'on' : ''" focusable="true" @click="nav('chat')">
          <svg width="20" height="20" viewBox="0 0 24 24">
            <path fill="currentColor" d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/>
          </svg>
          <div class="nav-tick" :visible="page=='chat'"></div>
        </div>

        <div class="nav" :class="page=='dashboard' ? 'on' : ''" focusable="true" @click="nav('dashboard')">
          <svg width="20" height="20" viewBox="0 0 24 24">
            <path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/>
          </svg>
          <div class="nav-tick" :visible="page=='dashboard'"></div>
        </div>

        <div class="nav-spacer"/>

        <div class="nav" :class="page=='settings' ? 'on' : ''" focusable="true" @click="nav('settings')">
          <svg width="20" height="20" viewBox="0 0 24 24">
            <path fill="currentColor" d="M19.43 12.98c.04-.32.07-.65.07-.98s-.02-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.38-.31-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65A.488.488 0 0014 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.58-1.69.98l-2.49-1a.49.49 0 00-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.08.65-.08.98s.03.66.08.98l-2.11 1.65c-.19.15-.25.42-.12.64l2 3.46c.12.22.38.31.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.58 1.69-.98l2.49 1c.23.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5A3.5 3.5 0 1112 8a3.5 3.5 0 010 7.5z"/>
          </svg>
          <div class="nav-tick" :visible="page=='settings'"></div>
        </div>
      </div>

      <div class="content">

        <div v-if="page=='chat'" class="chat-page">
          <div class="chat-status-bar">
            <label class="chat-status-text">{{ chatStatusDetail || $t(chatStatusKey) }}</label>
          </div>

          <ScrollView id="chat_scroll" class="chat-scroll">
            <div class="chat-list">
              <div v-if="messages.length == 0" class="chat-empty">
                <svg class="chat-empty-icon" width="36" height="36" viewBox="0 0 24 24">
                  <path fill="currentColor" d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/>
                </svg>
                <label class="chat-empty-text">{{ $t('chat_empty') }}</label>
              </div>

              <div
                v-for="m in messages"
                :key="m.id"
                :class="m.role == 'user' ? 'msg user' : 'msg bot'"
              >
                <label class="msg-text">{{ m.text }}</label>
              </div>
            </div>
          </ScrollView>

          <div class="composer">
            <input
              id="chat_input"
              class="chat-input"
              v-model="draft"
              :placeholder="$t('chat_placeholder')"
            />
            <div id="btn_chat_stop" class="btn-chat-stop" focusable="true" :enabled="turnWaiting"
                 :opacity="hover=='btn_chat_stop' && turnWaiting && page=='chat' ? 0.92 : 1"
                 @mouseenter="hin('btn_chat_stop')" @mouseleave="hout('btn_chat_stop')">
              <label class="btn-chat-stop-label">{{ $t('chat_cancel_wait') }}</label>
            </div>
            <div id="btn_send" class="btn-send" focusable="true" :enabled="canSend"
                 :opacity="hover=='btn_send' && canSend && page=='chat' ? 0.92 : 1"
                 @mouseenter="hin('btn_send')" @mouseleave="hout('btn_send')">
              <label class="btn-send-label">{{ $t('chat_send') }}</label>
            </div>
          </div>
        </div>

        <div v-if="page=='dashboard'" class="page-scroll">
          <div v-if="!installed" class="install-hint">
            <label class="install-hint-title">{{ $t('install_not_found') }}</label>
            <label class="install-hint-text">{{ installing ? $t('install_running') : $t('install_hint') }}</label>
            <div id="btn_install_nanobot" class="install-btn" focusable="true" :enabled="!installing"
                 :opacity="hover=='btn_install_nanobot' && !installing && page=='dashboard' ? 0.92 : 1"
                 @mouseenter="hin('btn_install_nanobot')" @mouseleave="hout('btn_install_nanobot')">
              <label class="install-btn-label">{{ $t('install_action') }}</label>
            </div>
          </div>

          <div class="hero-panel">
            <div class="hero-status-row">
              <div class="led-cell">
                <div :class="statusRingClass" :width="ringSize" :height="ringSize">
                  <div :class="statusDotClass" :opacity="ambientGlow"></div>
                </div>
              </div>
              <label class="hero-status" id="status_text">{{ statusText }}</label>
            </div>
            <label class="hero-sub" id="status_sub">{{ statusSub }}</label>
          </div>

          <div class="metrics" id="metrics">
            <div class="metric">
              <label class="metric-val" id="m_port">{{ port }}</label>
              <label class="metric-label">{{ $t('metric_port') }}</label>
            </div>
            <div class="metric">
              <label class="metric-val" id="m_pid">{{ pid }}</label>
              <label class="metric-label">{{ $t('metric_pid') }}</label>
            </div>
            <div class="metric">
              <label class="metric-val" id="m_uptime">{{ uptime }}</label>
              <label class="metric-label">{{ $t('metric_uptime') }}</label>
            </div>
          </div>

          <div class="actions">
            <div id="btn_start" class="btn btn-start" focusable="true" :enabled="canStart">
              <svg width="12" height="12" viewBox="0 0 24 24">
                <path fill="currentColor" d="M8 5v14l11-7z"/>
              </svg>
              <label class="btn-label">{{ $t('btn_start') }}</label>
            </div>
            <div id="btn_stop" class="btn btn-stop" focusable="true" :enabled="canStop">
              <svg width="12" height="12" viewBox="0 0 24 24">
                <path fill="currentColor" d="M6 6h12v12H6z"/>
              </svg>
              <label class="btn-label">{{ $t('btn_stop') }}</label>
            </div>
            <div id="btn_refresh" class="btn btn-refresh" focusable="true" :enabled="canRefresh">
              <svg width="12" height="12" viewBox="0 0 24 24">
                <path fill="currentColor" d="M17.65 6.35A7.95 7.95 0 0012 4a8 8 0 107.75 10h-2.1A6 6 0 1112 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4z"/>
              </svg>
              <label class="btn-label">{{ $t('btn_refresh') }}</label>
            </div>
          </div>
        </div>

        <div v-if="page=='settings'" class="settings-glass">
        <ScrollView class="settings-scroll">
          <label class="settings-section-title">{{ $t('settings_general') }}</label>

          <div class="setting-row">
            <div class="setting-label-wrap">
              <label class="setting-label">{{ $t('setting_autostart') }}</label>
              <label class="setting-sub">{{ $t('setting_autostart_sub') }}</label>
            </div>
            <toggle id="toggle_autostart" v-model="autostart"/>
          </div>

          <div class="setting-row">
            <div class="setting-label-wrap">
              <label class="setting-label">{{ $t('setting_tray') }}</label>
              <label class="setting-sub">{{ $t('setting_tray_sub') }}</label>
            </div>
            <toggle id="toggle_tray" v-model="stayInTray"/>
          </div>

          <div class="setting-row">
            <div class="setting-label-wrap">
              <label class="setting-label">{{ $t('setting_hotkey') }}</label>
              <label class="setting-sub">{{ $t('setting_hotkey_sub') }}</label>
            </div>
            <toggle id="toggle_hotkey" v-model="hotkeyEnabled"/>
          </div>

          <div class="path-row">
            <label class="setting-label">{{ $t('setting_path') }}</label>
            <div class="path-display" id="btn_change_path" focusable="true">
              <label class="path-text" id="path_text">{{ nanobotPath }}</label>
              <label class="path-change">{{ $t('setting_path_change') }}</label>
            </div>
          </div>

          <label class="settings-section-title">{{ $t('settings_network') }}</label>

          <div class="setting-row setting-col">
            <div class="setting-label-wrap">
              <label class="setting-label">{{ $t('setting_gateway_port') }}</label>
              <label class="setting-sub">{{ gatewayPortSub }}</label>
            </div>
            <input id="health_port_input" v-model="healthPort" class="port-input"/>
          </div>

          <div class="setting-row setting-col">
            <div class="setting-label-wrap">
              <label class="setting-label">{{ $t('setting_webui_port') }}</label>
              <label class="setting-sub">{{ webuiPortSub }}</label>
            </div>
            <input id="webui_port_input" v-model="webuiPort" class="port-input"/>
          </div>

          <div class="credential-row">
            <div class="credential-status-wrap">
              <label class="credential-status-label">{{ $t('setting_credential_status') }}</label>
              <label class="credential-status-val" id="credential_status_text">{{ credentialStatus }}</label>
            </div>
            <div class="credential-actions">
              <div id="btn_clear_credential" class="credential-btn" focusable="true" :enabled="hasCredential"
                   :opacity="hover=='btn_clear_credential' && hasCredential && page=='settings' ? 0.92 : 1"
                   @mouseenter="hin('btn_clear_credential')" @mouseleave="hout('btn_clear_credential')">
                <label class="credential-btn-label">{{ $t('setting_credential_clear') }}</label>
              </div>
              <div id="btn_manage_credential" class="credential-btn" focusable="true"
                   :opacity="hover=='btn_manage_credential' && page=='settings' ? 0.92 : 1"
                   @mouseenter="hin('btn_manage_credential')" @mouseleave="hout('btn_manage_credential')">
                <label class="credential-btn-label">{{ $t('setting_credential_manage') }}</label>
              </div>
            </div>
          </div>

          <div class="apply-row">
            <div id="btn_apply_network" class="apply-btn" focusable="true"
                 :opacity="hover=='btn_apply_network' && page=='settings' ? 0.92 : 1"
                 @mouseenter="hin('btn_apply_network')" @mouseleave="hout('btn_apply_network')">
              <label class="apply-btn-label">{{ $t('setting_apply') }}</label>
            </div>
          </div>

          <label class="settings-section-title">{{ $t('settings_appearance') }}</label>

          <div class="setting-row">
            <div class="setting-label-wrap">
              <label class="setting-label">{{ $t('setting_theme') }}</label>
            </div>
            <div class="theme-row">
              <div id="theme_light" focusable="true" :class="theme == 'light' ? 'theme-btn theme-btn-active' : 'theme-btn'">
                <svg width="14" height="14" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
                  <line x1="12" y1="2" x2="12" y2="5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="12" y1="19" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="2" y1="12" x2="5" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="19" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="4.93" y1="4.93" x2="7.05" y2="7.05" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="16.95" y1="16.95" x2="19.07" y2="19.07" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="4.93" y1="19.07" x2="7.05" y2="16.95" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="16.95" y1="7.05" x2="19.07" y2="4.93" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div id="theme_dark" focusable="true" :class="theme == 'dark' ? 'theme-btn theme-btn-active' : 'theme-btn'">
                <svg width="14" height="14" viewBox="0 0 24 24">
                  <path fill="currentColor" d="M12 3a9 9 0 109 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 01-4.4 2.26 5.403 5.403 0 01-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
                </svg>
              </div>
              <div id="theme_system" focusable="true" :class="theme == 'system' ? 'theme-btn theme-btn-active' : 'theme-btn'">
                <svg width="14" height="14" viewBox="0 0 24 24">
                  <rect x="3" y="4" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
                  <line x1="8" y1="21" x2="16" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="12" y1="17" x2="12" y2="21" stroke="currentColor" stroke-width="2"/>
                </svg>
              </div>
            </div>
          </div>

          <div class="setting-row">
            <div class="setting-label-wrap">
              <label class="setting-label">{{ $t('setting_language') }}</label>
            </div>
            <div class="lang-row">
              <div id="lang_zh" focusable="true" :class="lang == 'zh' ? 'lang-btn lang-btn-active' : 'lang-btn'">
                <label>中文</label>
              </div>
              <div id="lang_en" focusable="true" :class="lang == 'en' ? 'lang-btn lang-btn-active' : 'lang-btn'">
                <label>EN</label>
              </div>
            </div>
          </div>

          <div class="setting-row">
            <div class="setting-label-wrap">
              <label class="setting-label">{{ $t('setting_log_level') }}</label>
            </div>
            <div class="lang-row">
              <div id="log_debug" focusable="true" :class="logLevel == 'debug' ? 'lang-btn lang-btn-active' : 'lang-btn'">
                <label>DEBUG</label>
              </div>
              <div id="log_info" focusable="true" :class="logLevel == 'info' ? 'lang-btn lang-btn-active' : 'lang-btn'">
                <label>INFO</label>
              </div>
              <div id="log_warn" focusable="true" :class="logLevel == 'warn' ? 'lang-btn lang-btn-active' : 'lang-btn'">
                <label>WARN</label>
              </div>
              <div id="log_error" focusable="true" :class="logLevel == 'error' ? 'lang-btn lang-btn-active' : 'lang-btn'">
                <label>ERROR</label>
              </div>
            </div>
          </div>

          <div class="settings-footer">
            <label class="footer-ver" id="footer_version">v1.6.2</label>
            <div id="btn_webui" class="footer-link" focusable="true">
              <label class="footer-link-text">{{ $t('open_webui') }}</label>
              <svg width="10" height="10" viewBox="0 0 24 24">
                <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </ScrollView>
        </div>

      </div>
    </div>
  </div>
</template>
